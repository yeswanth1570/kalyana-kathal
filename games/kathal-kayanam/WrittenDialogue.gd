const ACT_INTROS := ["", "பொறியியல் கல்லூரி. ஃபில்டர் காபி. ஒரு பழைய தோழி.\nஉணவகக் குழப்பத்தைக் கடந்து ஷர்மிளாவிடம் பேசு.", "குடும்பச் சந்திப்பு இன்று மாலை. மென்பொருள் வெளியீடு இன்று.\nஅவசரக் கோரிக்கைகளுக்கு நடுவே பொறுப்பை ஒப்படைக்க வழி தேடு.", "இந்த நேர்காணலுக்கு வேலை விவரம் கிடையாது.\nநிதானமாக இருந்து மனதில் இருப்பதைச் சொல்.", "மாலைகளைக் காணவில்லை! உறவினர்களின் ஆரவாரம்!\nகுழப்பத்தைக் கடந்து மனதார ஒரு வாக்குறுதி கொடு."]
const ACT_ENDINGS := ["", "‘ஒரு காபி. விழாவுக்கு நீ உதவ வேண்டும்!’\nஷர்மிளா சிரிக்கிறாள். ஏதோ நல்லது தொடங்குகிறது.", "‘சோதனைகள் முடிந்ததா? பொறுப்பை ஒப்படைத்தாயா? கிளம்பலாம்!’\nகார்த்திக் கணினியை மூடுகிறார். மாலை உனக்கானது.", "அம்மா இன்னொரு காபி ஊற்றுகிறார். அப்பா செய்தித்தாளுக்குப் பின்னால் சிரிக்கிறார்.\n‘ஞாயிற்றுக்கிழமை உன் பெற்றோரை அழைத்து வா. எல்லோரும் பேசலாம்.’", "மாலைகள் மாறின. குடும்பத்தினர் உற்சாகத்தில் குரல் எழுப்பினர். இசை தொடங்குகிறது.\nஇனி நீங்கள் சேர்ந்து உருவாக்கும் வாழ்க்கைதான் பெரிய சாகசம்."]
const SCHOOL_INTROS := ["நடைபாதையின் மறுபுறம் ஷர்மிளா சிரிக்கிறாள். அவளுடைய குறிப்பேட்டிலிருந்து ஒரு தாள் விழுகிறது. முருகன் அதைப் பிடிக்கிறான். அவன் பேசுவதற்குள் சுந்தரத்தின் விசில் கேட்கிறது.", "ரேவதி ஆசிரியர் பாடத்தைத் தொடங்குகிறார். கடைசி பெஞ்சில் முருகன் ஒரு குறிப்பை மடிக்கிறான். ஷர்மிளா மூன்று வரிசைகள் முன்னால் இருக்கிறாள்.", "பள்ளி முடிந்தது. ‘பேருந்து நிறுத்தத்தில் சந்திப்போம்!’ என்று ஷர்மிளா கையசைக்கிறாள். முருகன் தேநீர்க் கடை வழியாக நடக்கிறான்."]
const SCHOOL_QUESTIONS := ["நீ வகுப்புக்கு வந்துவிட்டாய். நடைபாதைக்கு எதற்காகப் போனாய்?", "பாடம் முடிந்தபின் அந்தக் குறிப்பைப் பார்த்தேன். ஷர்மிளாவிடம் என்ன சொல்ல நினைத்தாய்?", "வந்துவிட்டாயே! உன் குறிப்பு என்னிடம் இருக்கிறது. பேருந்து வருவதற்குள் என்ன சொல்ல நினைத்தாய்?"]
