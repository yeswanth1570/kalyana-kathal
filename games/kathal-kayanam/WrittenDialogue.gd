const HOME_ENDINGS := {"talk": "‘உன் குறிப்பைப் படித்தேன். பேருந்து வர ஒரு நிமிடம் இருக்கிறது. கணக்குப் பாடத்தின்போது எப்படி எழுதினாய்?’", "later": "‘வீட்டுக்குப் போன பிறகு நிதானமாகப் படிக்கிறேன்,’ என்கிறாள் ஷர்மிளா. ‘நாளை சந்திப்போம்.’", "friends": "‘முதலில் நண்பர்களாக இருப்போமா?’ என்கிறாள் ஷர்மிளா. முருகன் சிரிக்கிறான். ‘சரி.’"}

